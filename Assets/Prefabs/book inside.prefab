  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Will could see his mom\u2019s face clearly now through the fleshy window.
    Her hair stuck out in odd directions, obvious dark circles hung under her eyes,
    and her brows were drawn up creating deep lines on her forehead. Her hands met
    Will\u2019s on the other side of the wall, pressed against him \u2014 Will relished
    in the hint of warmth emanating from her,the first he\u2019s felt in days. Joyce
    then began prodding with more and more strength against the petition. Digging
    her fingernails into it, scraping and thrashing with increasing desperation.
    Will echoed her frantic movements. Chunks of rust coloured gunk embedding under
    his nails, grey slime slinking itself around his fingers. \n "
